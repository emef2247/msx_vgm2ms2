;[name=T01P05 lpf=1]
#opll_mode 0
#tempo 180
#title { "YM2413 Rapid Retrigger" }

; 目的: 同一音高の高速な KeyOn/Off 繰り返しで KeyOn エッジ検出と残響処理を確認
; パターン1: 休符を挟まず連続
; パターン2: タイ
; パターン3: スラー
; パターン4: 小休符入り
; パターン5: 音量を変えながら高速(レガート: タイでKeyOffを抑える)
; パターン6: オクターブを変化

9abcde o4l32
d @5  V15 [r]8
d @5  V15 [r]8
d @5  V15 [r]8
d @5  V15 [r]8
d @5  V15 c& v13 c& v11 c& v9 c& v7 c& v5 c& v3 c& v1 c
d @5  V15 [r]8

9abcde o5l8
d @5  V15 [r]8
d @5  V15 [r]8
d @5  V15 [r]8
d @5  V15 [r]8
d @5  V15 c& v13 c& v11 c& v9 c& v7 c& v5 c& v3 c& v1 c
d @5  V15 [r]8
